---
# Per-host variables for athena-lab (the experimental router box).
# Copy this file to host_vars/athena-lab.yml and fill in real values
# for the local machine. The .yml file is .gitignored.
#
#   cp ansible/host_vars/athena-lab.yml.example ansible/host_vars/athena-lab.yml
#   $EDITOR ansible/host_vars/athena-lab.yml

# SSH connection
ansible_host: 192.168.1.10
ansible_user: aether
ansible_become: true
# ansible_ssh_private_key_file: ~/.ssh/id_ed25519

# NIC topology — match the actual interface names on the experimental box.
# 1-port machines should set both to the same name and add a bridge or
# VLAN later (planned, not implemented in Phase 1).
network_wan_interface: enp1s0
network_lan_interface: enp2s0

# LAN segment served by dnsmasq
network_lan_address: 192.168.10.1/24
network_lan_dhcp_range_start: 192.168.10.100
network_lan_dhcp_range_end: 192.168.10.200

# Phase 2 (AdGuard Home) を入れた段階で false に。
# false なら dnsmasq は port=0 で DNS を停止し、LAN:53 は AdGuard が
# 受け持つ。Phase 1 単独で運用するなら true のまま (デフォルトと同じ)。
network_dnsmasq_dns_enabled: false
