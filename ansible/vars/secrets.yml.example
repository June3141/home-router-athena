---
# secrets.yml の雛形
# 実体ファイル ansible/vars/secrets.yml は .gitignore 対象。
# 以下の手順で作成し、ansible-vault で暗号化すること:
#
#   cp ansible/vars/secrets.yml.example ansible/vars/secrets.yml
#   ansible-vault encrypt ansible/vars/secrets.yml
#
# 復号は --ask-vault-pass か ANSIBLE_VAULT_PASSWORD_FILE で行う。

# Tailscale auth key
tailscale_authkey: "tskey-auth-xxxxxxxxxxxxxxxxxxxxxxxx"
